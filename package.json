{
  "name": "codemo",
  "private": true,
  "description": "Colder's Demo Codes",
  "keywords": [
    "demo"
  ],
  "author": {
    "name": "colder"
  },
  "prettier": {
    "importOrder": [
      "^react(-dom)?(/.+)*$",
      "<THIRD_PARTY_MODULES>",
      "^[./]"
    ],
    "importOrderSortSpecifiers": true,
    "pluginSearchDirs": [
      "."
    ],
    "printWidth": 100,
    "singleQuote": true
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^3.1.1",
    "@tsconfig/recommended": "^1.0.13",
    "http-server": "^14.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24",
    "pnpm": "10"
  },
  "packageManager": "pnpm@10.26.1"
}
